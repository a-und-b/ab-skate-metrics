# Pfad zum entpackten Apple-Health-Export (enthält Export.xml und workout-routes/)
HEALTH_EXPORT_PATH=/pfad/zum/apple_health_export

# Datenverzeichnis außerhalb des Repos — hier landet die SQLite-Datenbank
DATA_DIR=/pfad/zum/datenverzeichnis

# Geo-Fuzzing der Kartenansicht (ADR-0007). Default ist aktiv: Punkte außerhalb
# des Radius um den Median-Punkt der Session werden verworfen, damit die
# Anfahrt von zu Hause nicht dargestellt wird. Nur bewusst abschalten.
# GEO_FUZZ=off
# GEO_FUZZ_RADIUS_M=200
